{
  "name": "@boardcache/desktop",
  "productName": "boardCache",
  "version": "0.1.1",
  "private": true,
  "description": "References, research and plans on one infinite board",
  "desktopName": "boardcache.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --no-sandbox --smoke=/tmp/shots/desktop-smoke.png",
    "dist": "pnpm run client && electron-builder --config electron-builder.json",
    "client": "VITE_BUILD_ID=$(date +%s) pnpm --dir ../.. --filter @boardcache/client build && node ../../scripts/build-config.cjs > app-config.json && pnpm run mcp",
    "dist:mac": "pnpm run client && electron-builder --config electron-builder.json --mac",
    "dist:win": "pnpm run client && electron-builder --config electron-builder.json --win",
    "dist:linux": "pnpm run client && electron-builder --config electron-builder.json --linux",
    "mcp": "esbuild mcp/server.ts --bundle --platform=node --target=node18 --format=cjs --loader:.md=text --outfile=mcp/dist/boardcache-mcp.cjs --log-level=warning && esbuild mcp/http.ts --bundle --platform=node --target=node18 --format=cjs --loader:.md=text --outfile=mcp/dist/mcp-http.cjs --log-level=warning"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^25.9.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.0",
    "electron-builder-squirrel-windows": "26.15.3",
    "esbuild": "^0.28.1"
  },
  "author": "boardCache <admin@boardcache.com>",
  "homepage": "https://boardcache.com",
  "license": "Apache-2.0"
}
