{
  "name": "boardcache",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @boardcache/client dev",
    "build": "pnpm --filter @boardcache/client build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint",
    "desktop": "./scripts/build-desktop.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.9.12",
      "sharp": ">=0.35.0",
      "adm-zip": ">=0.6.0"
    }
  }
}
